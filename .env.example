# ───────── 실행 모드 ─────────
# server: DB·로그인·결제를 사용하는 실서비스 모드 / demo(또는 비움): 브라우저 저장소만 쓰는 체험 모드
NEXT_PUBLIC_APP_MODE=server

# ───────── 데이터베이스 (PostgreSQL 14+) ─────────
# 서버리스(Vercel 등)에서는 PgBouncer·Neon/Supabase 풀러 주소를 쓰세요 (인스턴스마다 연결 풀이 생김)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/ptbridge
DATABASE_POOL_SIZE=10
# 자체 서버에서 npm run start:cluster 로 띄울 프로세스 수 (기본: CPU 코어 수 - 1)
WEB_CONCURRENCY=

# ───────── 로그인 (Auth.js) ─────────
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://your-domain.com
# 카카오 디벨로퍼스 → 내 애플리케이션 → REST API 키 / 보안(Client Secret)
# Redirect URI: https://your-domain.com/api/auth/callback/kakao
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
# 네이버 개발자센터 → 애플리케이션 → Client ID / Secret
# Callback URL: https://your-domain.com/api/auth/callback/naver
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=
# 로그인 시 관리자 권한을 줄 이메일 (쉼표로 구분)
ADMIN_EMAILS=
# 개발 전용 이메일 로그인 (production 빌드에서는 무시됨)
DEV_LOGIN=false

# ───────── 민감정보 암호화 (면허번호·계좌·빌링키) ─────────
# openssl rand -base64 32  — 한번 정하면 바꾸지 마세요 (바꾸면 기존 데이터를 복호화할 수 없음)
ENCRYPTION_KEY=

# ───────── 결제 (토스페이먼츠) ─────────
# 개발자센터의 테스트 키로 먼저 연동 확인 → 계약 후 라이브 키로 교체
PAYMENTS_PROVIDER=toss
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ───────── 예약 작업 (기한 정산·멤버십 갱신) ─────────
# 크론이 /api/cron/sweep 를 Authorization: Bearer CRON_SECRET 로 호출
CRON_SECRET=

# ───────── 치료사 증빙 서류 저장소 ─────────
# 비우면 DB에 저장(개발용). 운영은 S3 호환 저장소 권장 (AWS S3, Cloudflare R2, Supabase Storage, MinIO)
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
